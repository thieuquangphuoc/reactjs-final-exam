# Copy this file to .env and paste your key from https://console.anthropic.com
# The key stays on the local dev server (no VITE_ prefix = never sent to the browser).
ANTHROPIC_API_KEY=

# Optional: model used for grading written answers (default: claude-opus-5-5).
# claude-haiku-5-5 is much cheaper if you practise a lot.
# ANTHROPIC_MODEL=claude-opus-5-5
